{
  "id": "operating_margin",
  "name": "Operating margin",
  "version": 1,
  "description": "Revenue from operations less operating expenses (cost of sales, employee benefits, depreciation, other expenses; finance costs, other income and tax excluded), as a share of revenue.",
  "unit": "percent",
  "places": 2,
  "inputs": {
    "revenue": {
      "measure": "flow",
      "label": "Revenue from operations",
      "lines": [
        "PL.REVENUE"
      ]
    },
    "opex": {
      "measure": "flow",
      "label": "Operating expenses",
      "lines": [
        "PL.COGS",
        "PL.EMPLOYEE",
        "PL.DEPRECIATION",
        "PL.OTHER_EXPENSES"
      ]
    }
  },
  "formula": "(revenue - opex) / revenue",
  "unavailableWhen": [
    {
      "input": "revenue",
      "op": "<=",
      "value": "0",
      "reason": "no revenue from operations in the period: operating margin is not defined"
    }
  ],
  "grain": [
    "book",
    "period"
  ],
  "sign": "Percent of revenue; positive = operating profit, negative = operating loss.",
  "filters": {
    "voucherTypes": "closing vouchers excluded from flows",
    "provisional": "provisional (unconfirmed) journals included",
    "entity": "one book"
  },
  "period": {
    "type": "flow",
    "semantics": "flows over the period from..to"
  },
  "source": [
    "reporting.daily",
    "reporting.lines",
    "statement mapping (book framework)"
  ],
  "owner": "Financial Controller",
  "freshness": {
    "maxLagJournals": 0,
    "note": "computed only from a projection that has caught up with the ledger"
  },
  "test": {
    "fixture": "company-small",
    "from": "2026-04-01",
    "to": "2027-03-31",
    "expected": "62.50"
  }
}
