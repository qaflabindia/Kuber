{
  "name": "kuber-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:docker": "bash scripts/test-docker.sh",
    "e2e": "node scripts/e2e/walkthrough.mjs",
    "test:integration": "KUBER_INTEGRATION=1 vitest run tests/integration",
    "dev": "tsx watch apps/core/src/main.ts",
    "start": "tsx apps/core/src/main.ts",
    "migrate": "tsx apps/core/src/migrate-cli.ts",
    "demo": "tsx apps/core/src/demo.ts",
    "keys": "tsx apps/core/src/keys-cli.ts",
    "identity": "tsx apps/core/src/identity-cli.ts",
    "ops": "tsx apps/core/src/ops-cli.ts",
    "test:llm": "bash scripts/test-llm.sh",
    "register": "tsx scripts/check-register.ts",
    "eval:agent": "tsx scripts/eval-agent.ts",
    "test:mw": "test -x .venv/bin/python || { echo 'Set up the venv: python3 -m venv .venv && .venv/bin/pip install -e \"services/agent-mw[dev]\"'; exit 1; } && cd services/agent-mw && ../../.venv/bin/python -m pytest",
    "dream": "tsx apps/core/src/dream-cli.ts"
  },
  "devDependencies": {
    "@kuber/crypto": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.0.0",
    "fast-check": "^4.3.0",
    "fastify": "^5.6.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "^4.1.0"
  },
  "dependencies": {
    "@kuber/agent": "workspace:*",
    "@kuber/auth": "workspace:*",
    "@kuber/bank": "workspace:*",
    "@kuber/bus": "workspace:*",
    "@kuber/channels": "workspace:*",
    "@kuber/close": "workspace:*",
    "@kuber/consolidation": "workspace:*",
    "@kuber/contracts": "workspace:*",
    "@kuber/core": "workspace:*",
    "@kuber/dream-rsi": "workspace:*",
    "@kuber/eventstore": "workspace:*",
    "@kuber/evidence": "workspace:*",
    "@kuber/gl": "workspace:*",
    "@kuber/identity": "workspace:*",
    "@kuber/ops": "workspace:*",
    "@kuber/policy": "workspace:*",
    "@kuber/reporting": "workspace:*",
    "postgres": "^3.4.7"
  },
  "packageManager": "pnpm@10.28.0"
}
